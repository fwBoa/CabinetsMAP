sequenceDiagram
    autonumber
    actor Admin
    participant Browser as Navigateur
    participant AdminUI as admin.html
    participant AuthEP as /api/admin-auth
    participant CabinetsEP as /api/cabinets
    participant Session as session.js
    participant DB as Neon Postgres
    participant GeoEP as /api/geojson/cabinets
    participant Visitor as Visiteur public (cache CDN)

    rect rgba(220, 252, 231, 0.5)
        Note over Admin,DB: Phase 1 - Authentification (bcrypt + HMAC)
        Admin->>Browser: Ouvre /admin.html
        Browser->>AdminUI: Charge la page
        AdminUI->>Browser: Affiche champ "Mot de passe"
        Admin->>Browser: Tape CGC-EDIT-2026 + Valide
        Browser->>AuthEP: POST { password: "CGC-EDIT-2026" }
        AuthEP->>DB: select value from admin_settings where key='password_hash'
        DB-->>AuthEP: bcrypt hash
        AuthEP->>AuthEP: bcrypt.compare(input, hash)
        alt Mot de passe invalide
            AuthEP-->>Browser: 401 Unauthorized
            Browser->>AdminUI: "Mot de passe incorrect"
        else Mot de passe valide
            AuthEP->>Session: sign({ sub: "admin", exp: now+8h })
            Session->>AuthEP: cm_admin_session cookie
            AuthEP-->>Browser: 200 + Set-Cookie
            Browser->>AdminUI: Passe a la liste
        end
    end

    rect rgba(219, 234, 254, 0.5)
        Note over Admin,DB: Phase 2 - Chargement initial de la liste
        Browser->>CabinetsEP: GET /api/cabinets<br/>Cookie: cm_admin_session
        CabinetsEP->>Session: verify(cookie, SESSION_SECRET)
        Session-->>CabinetsEP: ok (sub=admin)
        CabinetsEP->>DB: select * from cabinets order by id
        DB-->>CabinetsEP: 14 rows
        CabinetsEP-->>Browser: 200 { cabinets: [FeatureCollection], count: 14 }
        Browser->>AdminUI: Render liste des 14 cabinets
    end

    rect rgba(254, 243, 199, 0.5)
        Note over Admin,DB: Phase 3 - Edition immdiate d'un cabinet
        Admin->>Browser: Click "Modifier" sur cabinet X
        Browser->>AdminUI: Ouvre sheet pr-rempli avec X
        Admin->>Browser: Change telephone + Click "Enregistrer"
        Browser->>Browser: Validation client (nom, format email, deps 01-95/971-976)
        Browser->>CabinetsEP: POST { action: "edit",<br/>payload: { id, properties: {...} } }
        CabinetsEP->>Session: verify(cookie)
        alt Session expiree
            CabinetsEP-->>Browser: 401
            Browser->>AdminUI: Toast "Session expiree" + retour login
        else Cookie valide
            CabinetsEP->>DB: select existing row
            DB-->>CabinetsEP: cabinet X
            CabinetsEP->>CabinetsEP: Merge payload + existant
            CabinetsEP->>DB: update cabinets set ... where id = X
            DB-->>CabinetsEP: ok
            CabinetsEP->>DB: select all (renvoi liste a jour)
            DB-->>CabinetsEP: 14 rows
            CabinetsEP-->>Browser: 200 { ok, merged: true, cabinets: [...] }
            Browser->>AdminUI: Toast "Modifications enregistrees"<br/>MAJ optimiste de la liste
        end
    end

    rect rgba(252, 165, 165, 0.3)
        Note over Visitor,DB: Phase 4 - Live sync vers visiteur public
        Note over Visitor,DB: Cache-Control 60s sur GeoJSON,<br/>poll client toutes les 2min
        loop Toutes les 2 minutes
            Visitor->>GeoEP: GET /api/geojson/cabinets (cache-bust)
            GeoEP->>DB: select all
            DB-->>GeoEP: 14 rows with cabinet X modifi
            GeoEP-->>Visitor: 200 FeatureCollection
            Visitor->>Visitor: loadData() + App.map.refreshCabinets()
            Visitor->>Visitor: MAJ markers + depts co-couvertes (hachures)
        end
        Note over Visitor,DB: Delai max = 60s cache + 2min poll = 2min30.
    end

    rect rgba(221, 214, 254, 0.4)
        Note over Admin,DB: Phase 5 - Anti-indexation (toutes les pages)
        Note over Admin,DB: robots.txt: Disallow: / + 8 bots IA bloques<br/>admin.html + carte: meta robots noindex<br/>Vercel headers: X-Robots-Tag, X-Frame DENY
    end
