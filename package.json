{
  "name": "cabinetsmap",
  "version": "1.0.0",
  "private": true,
  "description": "Carte interactive du reseau avocat CEGC - site statique + Vercel Functions pour l'edition admin.",
  "type": "module",
  "scripts": {
    "dev": "npx serve . -l 3000",
    "deploy": "vercel --prod",
    "build": "python3 scripts/build_index.py",
    "lint:js": "node --check scripts/test-admin-e2e.mjs && node --check middleware.js && find api assets -name '*.js' -exec node --check {} \\;",
    "lint:mermaid": "node /tmp/mmd-validate/validate.mjs docs/*.mmd",
    "test": "node scripts/test-admin-e2e.mjs",
    "test:read-only": "SKIP_MUTATIONS=1 node scripts/test-admin-e2e.mjs",
    "test:local": "BASE_URL=http://localhost:3000 node scripts/test-admin-e2e.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "vercel": "^32.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3"
  }
}
