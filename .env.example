# =============================================================================
# Variables d'environnement Vercel pour CabinetsMAP
# =============================================================================
# Ce fichier documente les variables requises.
# NE PAS COMMITER un fichier .env.local avec les vraies valeurs.
# Les vraies valeurs se configurent dans Vercel Dashboard :
#   Settings -> Environment Variables
# =============================================================================

# --- Authentification admin ---

# Hash SHA-256 du code d'accès admin (sans le prefixe "0x").
# Generation locale :
#   echo -n "VOTRE_CODE_SECRET" | shasum -a 256
# Exemple : ADMIN_CODE_HASH=a3f5b2c1d4e5f6789012345678901234abcdef0123456789012345678901234
ADMIN_CODE_HASH=

# Secret utilise pour signer le cookie de session admin.
# Minimum 32 caracteres, idealement 64.
# Generation locale :
#   openssl rand -hex 32
# Exemple : SESSION_SECRET=f8e7d6c5b4a39281...
SESSION_SECRET=

# --- GitHub API ---

# Personal Access Token GitHub (classic ou fine-grained).
# Pour PAT fine-grained : Repository access = Only select repositories,
#   selectionner fwBoa/CabinetsMAP
# Permissions : Contents = Read and Write, Pull requests = Read and Write
# Creer sur : https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Metadata du repo (constantes) ---

GITHUB_REPO_OWNER=fwBoa
GITHUB_REPO_NAME=CabinetsMAP
GITHUB_DEFAULT_BRANCH=main

# --- Duree de session (secondes, defaut 28800 = 8h) ---

ADMIN_SESSION_TTL_SECONDS=28800
