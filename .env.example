# =============================================================================
# Variables d'environnement Vercel pour CabinetsMAP
# =============================================================================
# Ce fichier documente les variables requises.
# NE PAS COMMITER un fichier .env.local avec les vraies valeurs.
# Les vraies valeurs se configurent dans Vercel Dashboard :
#   Settings -> Environment Variables
# =============================================================================

# --- Authentification admin ---

# Secret utilise pour signer le cookie de session admin.
# Minimum 32 caracteres, idealement 64.
# Generation locale :
#   openssl rand -hex 32
# Exemple : SESSION_SECRET=f8e7d6c5b4a39281...
SESSION_SECRET=

# Duree de session admin en secondes (defaut 28800 = 8h).
ADMIN_SESSION_TTL_SECONDS=28800

# --- Base de donnees Neon ---

# URL de connexion Postgres (Neon, ou toute autre base Postgres compatible).
# Sur Vercel : Storage -> Neon -> Connect project.
# Exemple : postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

